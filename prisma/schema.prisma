generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AUTH / UNIFIED LOGIN PORTAL
// ──────────────────────────────────────────────

enum UserRole {
  VIEWER          // زائر مسجل - يتصفح ويصوّت فقط
  EDITOR          // محرر - ينشئ ويعدّل مقالات، تمر تعديلاته على المراجع
  REVIEWER        // مراجع - يوافق أو يرفض مقالات المحررين فقط
  DEVELOPER       // مبرمج - يقترح تعديلات التصميم، تحتاج موافقة المدير
  EDITOR_IN_CHIEF // رئيس التحرير - يحرر وينشر ويحذف كل شيء، يتحكم بالمحررين
  ADMISSIONS      // عمادة القبول - تقبل أو ترفض طلبات الحسابات فقط
  DIRECTOR        // رئيس الوكالة / المدير - تحكم كامل بكل شيء
}

enum AccountStatus {
  PENDING_EMAIL   // بانتظار تفعيل الإيميل
  PENDING_ADMIN   // بانتظار موافقة عمادة القبول
  APPROVED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  passwordHash  String
  role          UserRole      @default(VIEWER)
  status        AccountStatus @default(PENDING_EMAIL)
  emailVerified DateTime?
  // For EDITOR-role users: رئيس التحرير can revoke editing ability without
  // changing their role/identity. Ignored for all other roles.
  canEdit       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  verificationCodes  VerificationCode[]
  articles           Article[]          @relation("ArticleAuthor")
  reviewedArticles   Article[]          @relation("ArticleReviewer")
  votes              Vote[]
  designProposals    DesignProposal[]   @relation("ProposedBy")
  permissionRequests PermissionRequest[]
  reviewedBy         String? // admin id who approved/rejected this account
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// SITE DESIGN SYSTEM (controlled entirely from admin panel,
// injected globally, force-applied on every page load)
// ──────────────────────────────────────────────

enum BackgroundType {
  SOLID
  GRADIENT
  IMAGE
}

model SiteSettings {
  id                 Int            @id @default(1)

  // Typography
  fontFamily         String         @default("Cairo")

  // Global background
  siteBgType         BackgroundType @default(SOLID)
  siteBgSolid        String         @default("#0B1220")
  siteBgGradientFrom String         @default("#0B1220")
  siteBgGradientTo   String         @default("#152238")
  siteBgImageUrl     String?

  // News card background
  cardBgType         BackgroundType @default(SOLID)
  cardBgSolid        String         @default("#121A2C")
  cardBgGradientFrom String?
  cardBgGradientTo   String?
  cardBgImageUrl     String?

  // Header background
  headerBgType       BackgroundType @default(SOLID)
  headerBgSolid      String         @default("#080D17")
  headerBgGradientFrom String?
  headerBgGradientTo   String?
  headerBgImageUrl     String?

  primaryColor       String         @default("#B8892B")
  accentColor        String         @default("#2B6E7A")
  textColor          String         @default("#E7E2D3")

  // Logo (persistent site logo, set from device upload via Cloudinary)
  logoUrl            String?
  // Optional temporary logo for a special occasion/event; overrides logoUrl while active
  eventLogoUrl        String?
  eventLogoActive     Boolean        @default(false)
  eventLogoLabel      String?

  siteNameAr         String         @default("وكالة الأنباء التنسيقية")
  siteNameEn         String         @default("Coordination News Agency")

  // LIVE streaming mode
  liveActive         Boolean        @default(false)
  liveYoutubeUrl     String?
  liveTitle          String?

  updatedAt          DateTime       @updatedAt
}

// ──────────────────────────────────────────────
// COUNTDOWN / EVENT COUNTER WIDGET
// ──────────────────────────────────────────────

enum CounterDirection {
  ASCENDING
  DESCENDING
}

model EventCounter {
  id            String           @id @default(cuid())
  title         String
  targetDate    DateTime
  direction     CounterDirection @default(DESCENDING)
  active        Boolean          @default(false)

  labelFontFamily String @default("Cairo")
  labelColor      String @default("#E7E2D3")
  numberFontFamily String @default("Cairo")
  numberColor     String @default("#B8892B")
  bgType          BackgroundType @default(SOLID)
  bgSolid         String  @default("#121A2C")
  bgGradientFrom  String?
  bgGradientTo    String?
  bgImageUrl      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ──────────────────────────────────────────────
// US ELECTION MAP (live interactive results)
// ──────────────────────────────────────────────

model ElectionCycle {
  id        String          @id @default(cuid())
  title     String          // e.g. "الانتخابات الأمريكية 2028"
  active    Boolean         @default(false)
  updatedAt DateTime        @updatedAt
  states    ElectionState[]
}

model ElectionState {
  id               String   @id @default(cuid())
  cycleId          String
  stateCode        String   // e.g. "CA", "TX"
  stateName        String
  electoralVotes   Int
  votesCandidateA  Int      @default(0)
  votesCandidateB  Int      @default(0)
  leaning          String   @default("TOSSUP") // BLUE | RED | TOSSUP
  reportingPercent Int      @default(0)

  cycle ElectionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, stateCode])
}

// ──────────────────────────────────────────────
// LOCAL POLLS / VOTING (registered users only)
// ──────────────────────────────────────────────

model Poll {
  id        String       @id @default(cuid())
  question  String
  active    Boolean      @default(true)
  endsAt    DateTime
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
}

model Vote {
  id       String     @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([pollId, userId]) // one vote per user per poll
}

// ──────────────────────────────────────────────
// CMS: DEPARTMENTS / ARTICLES
// ──────────────────────────────────────────────

model Department {
  id       String    @id @default(cuid())
  nameAr   String
  nameEn   String
  slug     String    @unique
  articles Article[]
}

enum ArticleSource {
  LOCAL   // كُتب يدويا عبر الـ CMS
  API     // مستورد من مصدر خارجي (NewsAPI / scraper) بقالب الموقع
}

enum ArticleStatus {
  DRAFT           // مسودة لدى المحرر، غير مرسلة للمراجعة بعد
  PENDING_REVIEW  // بانتظار قرار المراجع
  PUBLISHED       // منشور وظاهر للزوار
  REJECTED        // رفضها المراجع، لا تظهر إلا للمحرر ورئيس التحرير
  ARCHIVED
}

model Article {
  id           String        @id @default(cuid())
  titleAr      String
  slug         String        @unique
  excerpt      String?
  contentHtml  String        // rich text (Quill) output
  coverImageUrl String?
  source       ArticleSource @default(LOCAL)
  sourceName   String?       // e.g. "Reuters" when imported
  sourceUrl    String?
  status       ArticleStatus @default(DRAFT)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  authorId String?
  author   User?   @relation("ArticleAuthor", fields: [authorId], references: [id])

  // Editorial review workflow (محرر ← مراجع)
  submittedForReviewAt DateTime?
  reviewedById         String?
  reviewedBy           User?     @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  reviewNote           String?   // سبب الرفض إن وُجد

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  newspaperPageArticles NewspaperPageArticle[]
}

// ──────────────────────────────────────────────
// BREAKING NEWS
// ──────────────────────────────────────────────

enum BreakingNewsDisplay {
  TICKER
  POPUP
  BOTH
}

model BreakingNews {
  id         String              @id @default(cuid())
  text       String
  isAuto     Boolean             @default(false) // true = pulled from API
  display    BreakingNewsDisplay @default(TICKER)
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  expiresAt  DateTime?
}

// ──────────────────────────────────────────────
// DAILY NEWSPAPER (classic paginated layout + PDF export)
// ──────────────────────────────────────────────

model NewspaperIssue {
  id          String   @id @default(cuid())
  issueDate   DateTime @unique
  isAutoBuilt Boolean  @default(false)
  pdfUrl      String?
  createdAt   DateTime @default(now())
  pages       NewspaperPage[]
}

model NewspaperPage {
  id           String   @id @default(cuid())
  issueId      String
  pageNumber   Int
  sectionNameAr String  // محلي / رياضي / سياسي / اقتصادي ...
  issue        NewspaperIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  articles     NewspaperPageArticle[]

  @@unique([issueId, pageNumber])
}

model NewspaperPageArticle {
  id        String        @id @default(cuid())
  pageId    String
  articleId String
  position  Int           @default(0)
  page      NewspaperPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// DESIGN APPROVAL WORKFLOW (مبرمج يقترح ← مدير يوافق)
// ──────────────────────────────────────────────

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DesignProposal {
  id           String         @id @default(cuid())
  proposedById String
  proposedBy   User           @relation("ProposedBy", fields: [proposedById], references: [id])
  changes      Json           // partial SiteSettings fields being proposed
  status       ProposalStatus @default(PENDING)
  reviewNote   String?
  createdAt    DateTime       @default(now())
  decidedAt    DateTime?
}

// ──────────────────────────────────────────────
// PERMISSION REQUESTS (مراجع يطلب صلاحية تحرير من المدير)
// ──────────────────────────────────────────────

model PermissionRequest {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  message    String?
  status     ProposalStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?
}
